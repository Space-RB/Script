						AnimationSystem.Create(DisabledFrame.DisabledText, 0.25, { TextTransparency = 0.15 }, false)
						AnimationSystem.Create(DisabledFrame.DisabledImage, 0.25, { ImageTransparency = 0.25 }, false)
					end)
					multiDropdownMain.MouseLeave:Connect(function()
						AnimationSystem.Create(DisabledFrame, 0.25, { BackgroundTransparency = 0.25 }, false)
						AnimationSystem.Create(DisabledFrame.UIStroke, 0.25, { Transparency = 0.15 }, false)
						AnimationSystem.Create(DisabledFrame.DisabledText, 0.25, { TextTransparency = 1 }, false)
						AnimationSystem.Create(DisabledFrame.DisabledImage, 0.25, { ImageTransparency = 0.15 }, false)
					end)
					table.insert(windowFunctions, multiDropdownData)
					return multiDropdownData
				end
				local packedCurrentOption = multiDropdownData.CurrentOption or {}
				if flag and type(Library.Flags[flag]) == "table" then
					packedCurrentOption = Library.Flags[flag]
				end
				if #packedCurrentOption == 0 then
					optionText.Text = "Select options"
				elseif #packedCurrentOption == 1 then
					optionText.Text = "An option selected"
				elseif #packedCurrentOption == #options then
					optionText.Text = "All options selected"
				else
					optionText.Text = "Options selected"
				end
				trackThread(task.spawn(CallbackSystem.SafeCall, name, callback, packedCurrentOption))
				multiDropdownMain.MouseEnter:Connect(function()
					AnimationSystem.Create(
						multiDropdownMain,
						0.25,
						{ BackgroundColor3 = COLORS.BACKGROUND_HOVER },
						false
					)
					AnimationSystem.Create(multiDropdown, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_HOVER }, false)
					AnimationSystem.Create(frameList, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_HOVER }, false)
					if #options > 3 then
						AnimationSystem.Create(list, 0.25, { ScrollBarImageTransparency = 0 }, false)
					end
				end)
				multiDropdownMain.MouseLeave:Connect(function()
					AnimationSystem.Create(
						multiDropdownMain,
						0.25,
						{ BackgroundColor3 = COLORS.BACKGROUND_DARK },
						false
					)
					AnimationSystem.Create(multiDropdown, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_DARK }, false)
					AnimationSystem.Create(frameList, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_DARK }, false)
					if #options > 3 then
						AnimationSystem.Create(list, 0.25, { ScrollBarImageTransparency = 0.25 }, false)
					end
				end)
				browserTextBox.Focused:Connect(function()
					AnimationSystem.Create(browserTextBox, 0.25, { TextTransparency = 0.25 }, false)
				end)
				browserTextBox.FocusLost:Connect(function()
					AnimationSystem.Create(browserTextBox, 0.25, { TextTransparency = 0.5 }, false)
					for _, option in ipairs(list:GetChildren()) do
						if option:IsA("TextButton") and option ~= optionTemplate then
							if
								browserTextBox.Text ~= ""
								and not string.find(option.Text:lower(), browserTextBox.Text:lower())
							then
								option.Visible = false
							else
								option.Visible = true
							end
						end
					end
				end)
				turnAllButton.MouseEnter:Connect(function()
					AnimationSystem.Create(turnAllButton, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_DARK }, false)
				end)
				turnAllButton.MouseLeave:Connect(function()
					AnimationSystem.Create(turnAllButton, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_LIGHT }, false)
				end)
				local oldCallback = callback
				local ignoreChange = false
				local oldOptions = {}
				local oldTimeAll = tick()
				local function toggleAll(currentValue)
					if tick() - oldTimeAll < CONFIG.TURN_ALL_COOLDOWN then
						return
					end
					currentValue = currentValue == nil and not turnAllButton:GetAttribute("All")
					turnAllButton:SetAttribute("All", currentValue)
					if currentValue then
						AnimationSystem.Create(
							turnAllButton.Checkbox,
							0.25,
							{ BackgroundColor3 = COLORS.TOGGLE_ENABLED },
							false
						)
						AnimationSystem.Create(turnAllButton.Checkbox, 0.25, { BackgroundTransparency = 0.25 }, false)
						AnimationSystem.Create(turnAllButton, 0.25, { TextTransparency = 0.25 }, false)
					else
						AnimationSystem.Create(
							turnAllButton.Checkbox,
							0.25,
							{ BackgroundColor3 = COLORS.TOGGLE_DISABLED },
							false
						)
						AnimationSystem.Create(turnAllButton.Checkbox, 0.25, { BackgroundTransparency = 0 }, false)
						AnimationSystem.Create(turnAllButton, 0.25, { TextTransparency = 0.5 }, false)
					end
					ignoreChange = true
					callback = function() end
					for _, info in ipairs(oldOptions) do
						if currentValue and not info.IsEnabled() then
							trackThread(task.spawn(info.Function, true))
						elseif not currentValue and info.IsEnabled() then
							trackThread(task.spawn(info.Function, true))
						end
					end
					ignoreChange = false
					callback = oldCallback
					if currentValue then
						packedCurrentOption = table.clone(options)
					else
						packedCurrentOption = {}
					end
					trackThread(task.spawn(CallbackSystem.SafeCall, name, callback, packedCurrentOption))
					if flag then
						Library.Flags[flag] = packedCurrentOption
						trackThread(task.spawn(ConfigurationSystem.Save, Library.Flags))
					end
					oldTimeAll = tick()
				end
				turnAllButton.MouseButton1Click:Connect(toggleAll)
				turnAllButton.Checkbox.MouseButton1Click:Connect(toggleAll)
				local function createOptions(optionList)
					for _, optionName in ipairs(optionList) do
						local option = optionTemplate:Clone()
						option.Parent = list
						option.Visible = true
						option.Text = optionName
						option.Name = optionName
						local checkbox = option.Checkbox
						local isOptionEnabled = table.find(packedCurrentOption, optionName) ~= nil
						if not isOptionEnabled then
							checkbox.BackgroundColor3 = COLORS.TOGGLE_DISABLED
							checkbox.BackgroundTransparency = 0
							option.TextTransparency = 0.5
						else
							checkbox.BackgroundColor3 = COLORS.TOGGLE_ENABLED
							checkbox.BackgroundTransparency = 0.25
							option.TextTransparency = 0.25
						end
						option.MouseEnter:Connect(function()
							AnimationSystem.Create(option, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_DARK }, false)
						end)
						option.MouseLeave:Connect(function()
							AnimationSystem.Create(option, 0.25, { BackgroundColor3 = COLORS.BACKGROUND_LIGHT }, false)
						end)
						local function toggleOption(ignoreenabled)
							if not ignoreenabled then
								if not isEnabled then
									return
								end
							end
							isEnabled = false
							isOptionEnabled = not isOptionEnabled
							if isOptionEnabled then
								if not table.find(packedCurrentOption, optionName) then
									table.insert(packedCurrentOption, optionName)
								end
							else
								local index = table.find(packedCurrentOption, optionName)
								if index then
									table.remove(packedCurrentOption, index)
								end
							end
							if #packedCurrentOption == #options then
								turnAllButton:SetAttribute("All", true)
								AnimationSystem.Create(
									turnAllButton.Checkbox,
									0.25,
									{ BackgroundColor3 = COLORS.TOGGLE_ENABLED },
									false
								)
								AnimationSystem.Create(
									turnAllButton.Checkbox,
									0.25,
									{ BackgroundTransparency = 0.25 },
									false
								)
								AnimationSystem.Create(turnAllButton, 0.25, { TextTransparency = 0.25 }, false)
							else
								turnAllButton:SetAttribute("All", false)
								AnimationSystem.Create(
									turnAllButton.Checkbox,
									0.25,
									{ BackgroundColor3 = COLORS.TOGGLE_DISABLED },
									false
								)
								AnimationSystem.Create(
									turnAllButton.Checkbox,
									0.25,
									{ BackgroundTransparency = 0 },
									false
								)
								AnimationSystem.Create(turnAllButton, 0.25, { TextTransparency = 0.5 }, false)
							end
							trackThread(task.spawn(CallbackSystem.SafeCall, name, callback, packedCurrentOption))
							if flag and not ignoreChange then
								Library.Flags[flag] = packedCurrentOption
								trackThread(task.spawn(ConfigurationSystem.Save, Library.Flags))
							end
							if not isOptionEnabled then
								AnimationSystem.Create(
									checkbox,
									0.25,
									{ BackgroundColor3 = COLORS.TOGGLE_DISABLED },
									false
								)
								AnimationSystem.Create(checkbox, 0.25, { BackgroundTransparency = 0 }, false)
								AnimationSystem.Create(option, 0.25, { TextTransparency = 0.5 }, false)
							else
								AnimationSystem.Create(
									checkbox,
									0.25,
									{ BackgroundColor3 = COLORS.TOGGLE_ENABLED },
									false
								)
								AnimationSystem.Create(checkbox, 0.25, { BackgroundTransparency = 0.25 }, false)
								AnimationSystem.Create(option, 0.25, { TextTransparency = 0.25 }, false)
							end
							if #packedCurrentOption == 0 then
								optionText.Text = "Select options"
							elseif #packedCurrentOption == 1 then
								optionText.Text = "An option selected"
							elseif #packedCurrentOption == #options then
								optionText.Text = "All options selected"
							else
								optionText.Text = "Options selected"
							end
							needOpen = true
							isEnabled = true
						end
						option.MouseButton1Click:Connect(function()
							toggleOption()
						end)
						checkbox.MouseButton1Click:Connect(function()
							toggleOption()
						end)
						table.insert(oldOptions, {
							Function = toggleOption,
							Object = checkbox,
							IsEnabled = function()
								return isOptionEnabled
							end,
						})
					end
				end
				createOptions(options)
				if #packedCurrentOption == #options then
					turnAllButton:SetAttribute("All", true)
					AnimationSystem.Create(
						turnAllButton.Checkbox,
						0.25,
						{ BackgroundColor3 = COLORS.TOGGLE_ENABLED },
						false
					)
					AnimationSystem.Create(turnAllButton.Checkbox, 0.25, { BackgroundTransparency = 0.25 }, false)
					AnimationSystem.Create(turnAllButton, 0.25, { TextTransparency = 0.25 }, false)
				end
				trackThread(task.spawn(CallbackSystem.SafeCall, name, callback, packedCurrentOption))
				multiDropdown.MouseButton1Click:Connect(function()
					if isEnabled then
						if needOpen then
							isEnabled = false
							frameList.Visible = true
							list.Visible = true
							local animationTime = #options < 3 and 0.4 or 0.6
							AnimationSystem.Create(multiDropdown.Icon, animationTime, { Rotation = 180 }, false)
							AnimationSystem.Create(
								multiDropdownMain,
								animationTime,
								{ Size = UDim2.new(0.975, 0, 0, #options < 3 and 230 or 290) },
								true
							)
							needOpen = false
							isEnabled = true
						else
							isEnabled = false
							local animationTime = #options < 3 and 0.4 or 0.6
							AnimationSystem.Create(multiDropdown.Icon, animationTime, { Rotation = 0 }, false)
							AnimationSystem.Create(multiDropdownMain, 0.3, { Size = UDim2.new(0.975, 0, 0, 50) }, true)
							frameList.Visible = false
							list.Visible = false
							needOpen = true
							isEnabled = true
						end
					end
				end)
				local function updateCanvas(optionList)
					if #optionList < 3 then
						list.Size = UDim2.new(1, -5, 0, 180)
						list.ScrollingEnabled = false
					elseif #optionList == 3 then
						list.Size = UDim2.new(1, -5, 0, 240)
						list.ScrollingEnabled = false
					elseif #optionList > 3 then
						list.Size = UDim2.new(1, -5, 0, 240)
						list.ScrollingEnabled = true
						list.ScrollBarImageTransparency = 0.25
						list.ScrollBarThickness = 5
					end
				end
				updateCanvas(options)
				local function destroyOptions()
					for _, option in ipairs(list:GetChildren()) do
						if option:IsA("TextButton") and option ~= optionTemplate then
							option:Destroy()
						end
					end
				end
				function multiDropdownData:Set(currentOptions)
					if not isEnabled then
						return
					end
					isEnabled = false
					AnimationSystem.Create(multiDropdown.Icon, 0.3, { Rotation = 0 }, false)
					AnimationSystem.Create(multiDropdownMain, 0.3, { Size = UDim2.new(0.975, 0, 0, 50) }, true)
					frameList.Visible = false
					list.Visible = false
					destroyOptions()
					browserTextBox.Text = ""
					options = currentOptions or options
					createOptions(options)
					updateCanvas(options)
					toggleAll(false)
					needOpen = true
					isEnabled = true
				end
				table.insert(windowFunctions, multiDropdownData)
				return multiDropdownData
			end
			function tabFunctions:CreateParagraph(paragraphData)
				local title = paragraphData.Title
				local content = paragraphData.Content
				local paragraph = tabtemplate.ScrollingFrame.Paragraph:Clone()
				paragraph.Parent = scrollingFrame
				paragraph.Visible = true
				local function updateParagraph()
					local titleText = paragraph.Title
					titleText.Text = title
					local contentText = paragraph.Content
					contentText.Text = content
					titleText.Size = UDim2.new(
						titleText.Size.X.Scale,
						titleText.Size.X.Offset,
						titleText.Size.Y.Scale,
						(titleText.TextBounds.Y + 8) / frameScale.Scale
					)
					contentText.Size = UDim2.new(
						contentText.Size.X.Scale,
						contentText.Size.X.Offset,
						contentText.Size.Y.Scale,
						(contentText.TextBounds.Y + 16) / frameScale.Scale
					)
					paragraph.Size = UDim2.new(
						paragraph.Size.X.Scale,
						paragraph.Size.X.Offset,
						paragraph.Size.Y.Scale,
						titleText.Size.Y.Offset + contentText.Size.Y.Offset
					)
				end
				trackThread(task.spawn(updateParagraph))
				function paragraphData:Set(newData)
					title = newData.Title or title
					content = newData.Content or content
					trackThread(task.spawn(updateParagraph))
				end
				table.insert(windowFunctions, paragraphData)
				return paragraphData
			end
			function tabFunctions:CreateLabel(labelContent)
				local label = tabtemplate.ScrollingFrame.Label:Clone()
				label.Parent = scrollingFrame
				label.Visible = true
				local function updateLabel()
					label.TextLabel.Text = labelContent
					label.Size = UDim2.new(
						label.Size.X.Scale,
						label.Size.X.Offset,
						label.Size.Y.Scale,
						(label.TextLabel.TextBounds.Y + 16) / frameScale.Scale
					)
				end
				trackThread(task.spawn(updateLabel))
				local labelData = {}
				function labelData:Set(newText)
					labelContent = newText or labelContent
					trackThread(task.spawn(updateLabel))
				end
				table.insert(windowFunctions, labelData)
				return labelData
			end
			local tabRecord = blueprint[#blueprint]
			local methodsToRecord = {
				"CreateSection",
				"CreateButton",
				"CreateToggle",
				"CreateSlider",
				"CreateInput",
				"CreateKeybind",
				"CreateDropdown",
				"CreateMultiDropdown",
				"CreateParagraph",
				"CreateLabel",
			}
			local originals = {}
			for _, method in ipairs(methodsToRecord) do
				originals[method] = tabFunctions[method]
				tabFunctions[method] = function(self, arg)
					local argCopy
					if type(arg) == "string" then
						argCopy = arg
					else
						argCopy = {}
						for k, v in pairs(arg) do
							if k ~= "Set" then
								argCopy[k] = v
							end
						end
					end
					local result = originals[method](self, arg)
					table.insert(tabRecord.elements, { method = method, data = argCopy, handle = result })
					return result
				end
			end
			return tabFunctions
		end
		function windowFunctions:Load(LoadMode, ConfigText)
			if type(ConfigText) == "string" and ConfigText ~= "" then
				local Success, Decoded = pcall(function()
					return HttpService:JSONDecode(ConfigText)
				end)
				if Success and type(Decoded) == "table" then
					Library.Flags = Decoded
					ConfigurationSystem.Save(Decoded)
				end
			end
			for _, tabData in ipairs(Library.Tabs) do
				if tabData.button and tabData.button.Parent then
					tabData.button:Destroy()
				end
				if tabData.sectionBG and tabData.sectionBG.Parent then
					tabData.sectionBG:Destroy()
				end
			end
			table.clear(Library.Tabs)
			Library.SelectedTab = nil
			local savedBlueprint = {}
			for i, tabRecord in ipairs(blueprint) do
				savedBlueprint[i] = tabRecord
			end
			table.clear(blueprint)
			for _, tabRecord in ipairs(savedBlueprint) do
				local freshTab = windowFunctions:CreateTab(tabRecord.name, tabRecord.logo)
				for _, elem in ipairs(tabRecord.elements) do
					local freshData
					if type(elem.data) == "string" then
						freshData = elem.data
					else
						freshData = {}
						for k, v in pairs(elem.data) do
							freshData[k] = v
						end
					end
					local newHandle = freshTab[elem.method](freshTab, freshData)
					if elem.handle and newHandle and type(newHandle.Set) == "function" then
						elem.handle.Set = function(self, ...)
							return newHandle:Set(...)
						end
					end
				end
			end
			table.clear(savedBlueprint)
			if LoadMode == "NoGUI" then
				backgroundGUI.Visible = false
				backgroundToggle.Visible = false
				backgroundQuest.Visible = false
				backgroundNotification.Visible = false
			elseif LoadMode == "GUI" then
				backgroundToggle.Visible = true
				backgroundQuest.Visible = true
				backgroundNotification.Visible = true
				if not backgroundGUI.Visible then
					Library:Toggle()
				end
			end
		end
		trackThread(task.spawn(function()
			mainUI.Enabled = true
			Library:Toggle()
		end))
		mainUI.Destroying:Once(function()
			local emptyFunction = function() end
			for _, questData in ipairs(activeQuests) do
				questData.Destroyed = true
				questData.NeedDestroy = false
			end
			for _, thread in ipairs(notificationThreads) do
				pcall(task.cancel, thread)
			end
			for _, thread in ipairs(spaceThreads) do
				pcall(task.cancel, thread)
			end
			for _, conn in ipairs(spaceConnections) do
				pcall(function()
					conn:Disconnect()
				end)
			end
			table.clear(notificationThreads)
			table.clear(spaceThreads)
			table.clear(spaceConnections)
			table.clear(activeQuests)
			table.clear(Library.Flags)
			table.clear(Library.Tabs)
			table.clear(blueprint)
			table.clear(windowFunctions)
			Library.CreateWindow = emptyFunction
			Library.CreateQuest = emptyFunction
			Library.CreateNotification = emptyFunction
			Library.Toggle = emptyFunction
			table.clear(Library)
		end)
		return windowFunctions
	end
end
return Library
