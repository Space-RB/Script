	local fixerGui = Instance.new("ScreenGui")
	fixerGui.IgnoreGuiInset = true
	fixerGui.ResetOnSpawn = false
	fixerGui.DisplayOrder = -999
	fixerGui.Parent = uiparent or LocalPlayer:WaitForChild("PlayerGui")
