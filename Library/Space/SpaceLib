function Utils.CensorPlayerName(playerName)
	local nameLength = #playerName
	local censorLength = nameLength - (nameLength > 5 and 3 or 1)
	local visiblePart = string.sub(playerName, censorLength + 1)
	local censoredPart = string.rep("*", censorLength)
	return censoredPart .. visiblePart
end
local AnimationSystem = {}
local tweenInfoCache = {}
function AnimationSystem.GetTweenInfo(duration, style, direction)
	local key = tostring(duration) .. (style or "") .. (direction or "")
	if not tweenInfoCache[key] then
		tweenInfoCache[key] = TweenInfo.new(duration, style or EASING_STYLE, direction or EASING_DIRECTION)
	end
	return tweenInfoCache[key]
end
function AnimationSystem.Create(instance, duration, properties, waitForCompletion)
	if not instance or typeof(instance) ~= "Instance" then
		return
	end
	local tweenInfo = AnimationSystem.GetTweenInfo(duration)
	local success, error = pcall(function()
		local tween = TweenService:Create(instance, tweenInfo, properties)
		tween:Play()
		if waitForCompletion then
			tween.Completed:Wait()
		end
		return tween
	end)
	if not success then
		warn("[SpaceLib] Animation Error: ", error)
	end
	table.clear(properties)
end
local ConfigurationSystem = {}
local configPath = CONFIG.FOLDER_NAME .. "/" .. CONFIG.FILE_NAME
local lastSavedConfig = ""
function ConfigurationSystem.Initialize()
	if not isfolder(CONFIG.FOLDER_NAME) then
		makefolder(CONFIG.FOLDER_NAME)
	end
	if not isfile(configPath) then
		writefile(configPath, "")
	end
end
function ConfigurationSystem.Load(libraryFlags)
	local data = {}
	local loaded = false
	if type(_G.SpaceSettings) == "table" then
		data = _G.SpaceSettings
		loaded = true
	elseif isfile(configPath) then
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(configPath))
		end)
		if success and result then
			data = result
			loaded = true
		end
	end
	for flagName, flagValue in pairs(data) do
		libraryFlags[flagName] = flagValue
	end
	table.clear(data)
	return loaded
end
function ConfigurationSystem.Save(libraryFlags)
	local data = {}
	for flagName, flagValue in pairs(libraryFlags) do
		data[flagName] = flagValue
	end
	local currentConfig = HttpService:JSONEncode(data)
	table.clear(data)
	if lastSavedConfig ~= currentConfig then
		lastSavedConfig = currentConfig
		writefile(configPath, currentConfig)
	end
end
function DragSystem(frame, dragSpeed)
	local isDragging = false
	local dragStart = nil
	local startPosition = nil
	local function updatePosition(input)
		local delta = input.Position - dragStart
		local newPosition = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		local tweenInfo = TweenInfo.new(dragSpeed)
		TweenService:Create(frame, tweenInfo, { Position = newPosition }):Play()
	end
	local function onInputBegan(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			isDragging = true
			dragStart = input.Position
			startPosition = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					isDragging = false
				end
			end)
		end
	end
	local function onInputChanged(input)
		if
			(input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
			and isDragging
		then
			updatePosition(input)
		end
	end
	return onInputBegan, onInputChanged
end
local CallbackSystem = { FailureCounts = {} }
function CallbackSystem.SafeCall(functionName, callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local key = functionName .. tostring(callback)
	local success, err = pcall(callback, ...)
	if success then
		CallbackSystem.FailureCounts[key] = 0
		return
	end
	CallbackSystem.FailureCounts[key] = (CallbackSystem.FailureCounts[key] or 0) + 1
	local count = CallbackSystem.FailureCounts[key]
	if count >= 2 then
		warn(
			"[SpaceLib] Callback '",
			functionName,
			"' has failed 2 consecutive times and requires supervision, report this to the Discord server - ",
			err
		)
		return
	end
	warn("[SpaceLib] Callback Error: ", functionName, " - ", err)
	task.wait(5 + math.random())
	CallbackSystem.SafeCall(functionName, callback, ...)
end
